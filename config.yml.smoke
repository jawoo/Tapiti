# Tokki — Bolivia ENSO workspace
#
# Companion project folder: ~/Claude/bolivia-enso (data prep, calibration, analysis)
# Plan and data inventory:  ~/Claude/bolivia-enso/PLAN.md, DATA-INVENTORY.md
#
# Southern-hemisphere conventions used here:
#   - A campaign is labelled by its SOWING year. The 2026-27 campaña verano is
#     firstPlantingYear 2026; DSSAT starts the run on 1 Jan of the sowing year and
#     bounds harvest in the following year.
#   - Weather files must therefore extend one full year BEYOND the last sowing year,
#     or the final season will have no data to mature into.
#   - Keep sorgo/frejol median planting dates at or below DOY 335: the onset scan
#     window is +/-30 days and is truncated at 31 Dec (see the year-wrap fix, PR #9).

tableNameUnitInformation: unit-information
countryCode: BOL
soilFileName: BO.SOL   # base name must match the soilProfileId prefix (BO########)

numberOfThreads: 4
limitForDebugging: 20

# Hindcast span: sowing years 1983..2024 = 42 campaigns, matching the INE
# "Año Agrícola" series (1983-84 -> 2024-25). Requires weather through 2025.
firstPlantingYear: 2015
numberOfYears: 2

directory:
  weather: smoke
  working: res
  source: .csm
  temp: .temp
  input: input
  threads: threads
  result: result
  summary: summary
  flowering: flowering
  plantingDates: planting
  errors: error

scenarioCombinations: 0
scenarioSwitch:
  waterManagement: 1
  fertilizer: 1
  manure: 0
  residue: 0
  plantingWindow: 0
  plantingDensity: 0
  CO2fertilization: 0   # off: annual CO2 comes from CO2048.csv per simulation year

plantingDateOptions:
  useFixedPlantingDate: 0   # 0 = let the rainfall-onset scan pick the date per year.
  fixedPlantingDate: 320    # This is the channel that carries the ENSO signal into
                            # sowing date, so it must stay 0 for the ENSO runs.
                            # 320 = 16 Nov, the soya verano window midpoint, used only
                            # if the switch above is turned on for diagnostics.

latBandSize: 1          # degrees latitude per band for phenology stratification
                        # Bolivia spans roughly 10-23 S

useRecommendedNitrogenFertilizerRateOverride: 1
useRecordedWaterSupplyOverride: 1

nitrogenFertilizerRates:
 - 30
atmosphericCO2:
 - 450
